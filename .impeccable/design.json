  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary action in a region: approve, send, run.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></svg>Approve and send</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border:none;border-radius:6px;font:500 13px/1 Geist,-apple-system,sans-serif;cursor:pointer;transition:background-color 150ms ease-out,color 150ms ease-out,scale 150ms ease-out}.ds-btn:active{scale:.96}.ds-btn:focus-visible{outline:2px solid #1D4ED8;outline-offset:2px}.ds-btn-primary{background:#1D4ED8;color:#fff;box-shadow:inset 0 1px 0 rgb(255 255 255/.18),0 0 0 1px #1A44C2,0 1px 2px rgb(17 17 19/.12)}.ds-btn-primary:hover{background:#1E40AF}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Every other action; white with a hairline ring.",
      "html": "<button class=\"ds-btn2\">Edit draft</button>",
      "css": ".ds-btn2{display:inline-flex;align-items:center;height:32px;padding:0 12px;border:none;border-radius:6px;font:500 13px/1 Geist,-apple-system,sans-serif;background:#fff;color:#111113;box-shadow:0 0 0 1px rgb(17 17 19/.10),0 1px 2px rgb(17 17 19/.06);cursor:pointer;transition:background-color 150ms ease-out,scale 150ms ease-out}.ds-btn2:hover{background:#F3F3F4}.ds-btn2:active{scale:.96}.ds-btn2:focus-visible{outline:2px solid #1D4ED8;outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive actions: red text on a neutral button, never a red fill.",
      "html": "<button class=\"ds-btn-danger\">Reject</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;height:32px;padding:0 12px;border:none;border-radius:6px;font:500 13px/1 Geist,-apple-system,sans-serif;background:#fff;color:#B4232F;box-shadow:0 0 0 1px rgb(17 17 19/.10),0 1px 2px rgb(17 17 19/.06);cursor:pointer;transition:background-color 150ms ease-out,scale 150ms ease-out}.ds-btn-danger:hover{background:#F3F3F4}.ds-btn-danger:active{scale:.96}.ds-btn-danger:focus-visible{outline:2px solid #1D4ED8;outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Form fields with a cobalt focus halo.",
      "html": "<label class=\"ds-field\"><span>Daily send limit</span><input class=\"ds-input\" value=\"50\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;font:500 13px Geist,-apple-system,sans-serif;color:#111113}.ds-input{height:36px;padding:0 12px;font:400 14px Geist,-apple-system,sans-serif;background:#fff;color:#111113;border:1px solid #D6D6DB;border-radius:6px;transition:border-color 120ms ease,box-shadow 120ms ease}.ds-input:focus{outline:none;border-color:#1D4ED8;box-shadow:0 0 0 3px #EBF1FE}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Grouped sidebar with a lifted active item and waiting counts.",
      "html": "<nav class=\"ds-nav\"><div class=\"ds-nav-label\">Pipeline</div><button class=\"ds-nav-item on\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 10.5 12 3l9 7.5\"/><path d=\"M5.5 9v11h13V9\"/></svg><span>Today</span></button><button class=\"ds-nav-item\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 13h5l1.5 3h5l1.5-3h5\"/><path d=\"M5.5 5h13L21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-6z\"/></svg><span>Outbox</span><b class=\"ds-count\">5</b></button></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:1px;width:212px;background:#F6F6F7;padding:12px}.ds-nav-label{font:500 11px Geist,sans-serif;color:#8B8B93;text-transform:uppercase;letter-spacing:.06em;padding:0 10px 6px}.ds-nav-item{display:flex;align-items:center;gap:10px;height:32px;padding:0 10px;border:none;border-radius:6px;background:none;color:#5B5B63;font:500 13px/1 Geist,sans-serif;cursor:pointer;transition:background-color 120ms ease,color 120ms ease}.ds-nav-item span{flex:1;text-align:left}.ds-nav-item svg{color:#8B8B93}.ds-nav-item:hover{background:#F3F3F4;color:#111113}.ds-nav-item.on{background:#fff;color:#111113;box-shadow:0 0 0 1px rgb(17 17 19/.06),0 1px 2px -1px rgb(17 17 19/.06),0 2px 4px 0 rgb(17 17 19/.04)}.ds-nav-item.on svg{color:#1D4ED8}.ds-nav-item:focus-visible{outline:2px solid #1D4ED8;outline-offset:2px}.ds-count{min-width:20px;height:18px;padding:0 6px;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;border-radius:99px;background:#EBF1FE;color:#1D4ED8}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "badge-waiting",
      "description": "The only coloured text: dot + tint + hairline per status.",
      "html": "<span class=\"ds-badge w\">Needs you</span> <span class=\"ds-badge g\">Verified</span> <span class=\"ds-badge b\">Bounced</span> <span class=\"ds-badge a\">Sending</span> <span class=\"ds-tag\">Roofing</span>",
      "css": ".ds-badge,.ds-tag{display:inline-flex;align-items:center;gap:5px;height:22px;padding:0 8px;font:500 12px/1 Geist,sans-serif;border-radius:99px;border:1px solid transparent;white-space:nowrap}.ds-badge::before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}.ds-badge.w{background:#FFF4DE;color:#8A5A00;border-color:#F6DFAE}.ds-badge.g{background:#E8F6EE;color:#1F7A4D;border-color:#C6EAD5}.ds-badge.b{background:#FDECEE;color:#B4232F;border-color:#F7CDD2}.ds-badge.a{background:#E5F6F9;color:#0E7490;border-color:#BDE5EE}.ds-tag{background:#F3F3F4;color:#5B5B63;border-color:#E7E7EA}"
    },
    {
      "name": "KPI Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Lifted white card with a tabular headline number.",
      "html": "<div class=\"ds-card\"><div class=\"ds-kpi-label\">Waiting for you</div><div class=\"ds-kpi\">12</div><div class=\"ds-kpi-note\"><b>5</b> drafts \u00b7 7 replies</div></div>",
      "css": ".ds-card{background:#fff;border-radius:14px;padding:24px;width:220px;box-shadow:0 0 0 1px rgb(17 17 19/.06),0 1px 2px -1px rgb(17 17 19/.06),0 2px 4px 0 rgb(17 17 19/.04);font-family:Geist,sans-serif;font-variant-numeric:tabular-nums;transition:box-shadow 150ms ease-out}.ds-card:hover{box-shadow:0 0 0 1px rgb(17 17 19/.09),0 1px 2px -1px rgb(17 17 19/.08),0 2px 6px 0 rgb(17 17 19/.06)}.ds-kpi-label{font-size:13px;color:#5B5B63}.ds-kpi{font-size:28px;font-weight:600;letter-spacing:-.03em;line-height:1.1;color:#111113;margin:6px 0 4px}.ds-kpi-note{font-size:12px;color:#8B8B93}.ds-kpi-note b{color:#5B5B63;font-weight:500}"
    },
    {
      "name": "Draft Reply Bubble",
      "kind": "custom",
      "description": "An unsent reply awaiting approval: dashed cobalt edge, never mistaken for a sent message.",
      "html": "<div class=\"ds-draft\"><div class=\"ds-draft-label\">Draft reply</div><div>Thanks for getting back to me. Would Thursday at 10 work for a 15-minute call?</div></div>",
      "css": ".ds-draft{width:min(78%,64ch);padding:10px 14px 12px;border-radius:14px;border:1.5px dashed #CCDBFC;background:#EBF1FE;font:400 13px/1.55 Geist,sans-serif;color:#111113}.ds-draft-label{font-size:11px;font-weight:600;color:#1D4ED8;margin-bottom:4px}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Control Room",
    "overview": "Sellbird's dashboard is where a part-time operator checks on a machine that has been working without them. The room is calm by default: cool neutral paper, white surfaces, one typeface, almost no colour. When something needs a decision, it is the only thing that speaks. Cobalt marks where to act; five status hues mark what state things are in; everything else stays grey on purpose, so colour always carries meaning.\n\nDensity is that of a working tool, not a brochure: a fixed 236px sidebar, content capped at 1180px, 13\u201314px interface text on a small, strict scale, and tabular numbers so columns line up and changing counts never shift the layout. Surfaces are lifted with hairline shadows rather than outlined; space groups things, shadows lift surfaces, lines only divide. Motion is feedback only: buttons press, hovers exist only on real pointers, and nothing animates on a tab switch.\n\nLight and dark are the same design re-tokenised. Only the token layer changes between them; no component has a theme-specific rule.",
