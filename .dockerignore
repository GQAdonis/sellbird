# Only files required by COPY (or RUN --mount) enter the build context. Never
# send user data, credentials, Git history, environments, or browser artifacts
# to the builder.
**
!Dockerfile
# The hash-locked dependency list (scripts/ci/lock-requirements.sh). Neither
# requirements.txt nor pyproject.toml is a build input, so no unlocked install
# path can reach the image.
!requirements.lock
!sellbird.yaml
!sellbird/
!sellbird/**
!migrations/
!migrations/**
!prompts/
!prompts/**
!skills/
!skills/**
**/__pycache__
**/*.pyc
